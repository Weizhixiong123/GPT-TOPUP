# 生产环境配置模板：复制为 .env 后填写。只放在服务器上，不要提交到 Git。

NODE_ENV=production
PORT=3000
# 正式域名，必须是 https://
BASE_URL=https://你的域名

# Supabase 连接串（Connect → Session pooler）
DATABASE_URL=
# 线上用独立的 schema，和本地测试数据分开；首次启动自动建表
DB_SCHEMA=topup_prod

# 生成方法：docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：这个密钥用来加密用户的登录信息，上线后不要更换，否则处理中的订单会解不开
TOKEN_SECRET=

# 后台账号。用户名不要用 admin；密码至少 12 位
# 生成方法：docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_USER=
ADMIN_PASSWORD=

# 容器前面只有一层 Nginx 反向代理，信任 1 跳，才能拿到用户的真实 IP（限流依赖它）
TRUST_PROXY=1

# 支付渠道。none = 暂不接入在线支付，所有套餐都显示「联系客服购买」
# 接入后改为 alipay / wechat，并补上对应的商户参数（见仓库根目录 .env.example）
PAYMENT_PROVIDERS=none

# 上游
UPSTREAM_DRIVER=aiaiyg
REDEEM_MAX_QUERIES=180

# 人工服务套餐的编号（PAYMENT_PROVIDERS=none 时所有套餐都是人工，这里可以留空）
MANUAL_PLAN_IDS=

# 客服小窗
SUPPORT_WECHAT=
SUPPORT_QQ=
SUPPORT_HOURS=每天 9:00 - 23:00
SUPPORT_NOTE=充值失败请提供订单号，我们会尽快处理

PORT=3000

# PostgreSQL 连接串（必填）
# Supabase：项目顶部 Connect → Direct → Connection Method 选 Session pooler，把 [YOUR-PASSWORD] 替换成数据库密码
DATABASE_URL=postgresql://postgres.<项目ID>:<密码>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# 业务表所在 schema（不要用 public）
DB_SCHEMA=topup
DB_POOL_SIZE=10
# 对外访问地址（支付回调地址基于此生成，生产环境必须是公网 https）
BASE_URL=http://localhost:3000
# NODE_ENV=production

# 用户 Token 加密密钥（64 位 hex）：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=

# 反向代理信任：同机 Nginx 用 loopback（默认）；前面有 CDN/多层代理填跳数或代理 IP；无代理填 false
TRUST_PROXY=loopback

# 防恶意下单
ORDERS_PER_IP_PER_MIN=5
ORDERS_PER_IP_PER_HOUR=30
ORDERS_GLOBAL_PER_MIN=120
MAX_PENDING_PER_IP=5
TOKEN_PER_IP_PER_MIN=10
TOKEN_PER_IP_PER_HOUR=60

# 人工服务套餐的编号（逗号分隔，编号见后台套餐页）：这些套餐不能自助下单，前台按钮改为「联系客服购买」
MANUAL_PLAN_IDS=

# 前台「联系客服」小窗的内容：填了哪项就显示哪项
SUPPORT_WECHAT=
SUPPORT_QQ=
# Telegram 用户名，不带 @
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=
# 例：每天 9:00 - 23:00
SUPPORT_HOURS=
# 客服二维码图片：把图片放到 public/ 下，这里填站内路径，例：/kefu.png
SUPPORT_QR=
# 小窗底部的补充说明，例：充值失败请提供订单号，我们会尽快处理
SUPPORT_NOTE=

ORDER_EXPIRE_MINUTES=15
REDEEM_QUERY_INTERVAL_SEC=10
REDEEM_MAX_QUERIES=180
REDEEM_MAX_SUBMIT_RETRIES=3

# 支付渠道：mock（开发）/ alipay / wechat，可逗号分隔多个
PAYMENT_PROVIDERS=mock

# 支付宝当面付（密钥可填文件路径或单行内容）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=./certs/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY=./certs/alipay_public_key.pem

# 微信支付 APIv3 Native
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY=./certs/apiclient_key.pem
WECHAT_PLATFORM_PUBLIC_KEY=./certs/wechatpay_public_key.pem
WECHAT_PLATFORM_PUBLIC_KEY_ID=

# 上游兑换：
#   mock    本地开发用
#   aiaiyg  aiaiyg.com 卡密核销（已对接，无需 API Key；UPSTREAM_BASE_URL 留空即用 https://aiaiyg.com）
#   http    通用示例，见 src/upstream/http.ts，接入其他上游时照着改
UPSTREAM_DRIVER=mock
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
# 查询类接口的超时；aiaiyg 的提交接口固定用 90 秒（上游建单较慢）
UPSTREAM_TIMEOUT_MS=15000

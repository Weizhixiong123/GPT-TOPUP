PORT=3000

# 对外访问地址（生产环境必须是公网 https）
BASE_URL=http://localhost:3000
# NODE_ENV=production

# 反向代理信任：同机 Nginx 用 loopback（默认）；前面有 CDN/多层代理填跳数或代理 IP；无代理填 false
TRUST_PROXY=loopback

# 提交充值的频率限制（同一 IP）
REDEEM_PER_IP_PER_MIN=10
REDEEM_PER_IP_PER_HOUR=60

# 前台「联系客服」小窗的内容：填了哪项就显示哪项
SUPPORT_WECHAT=
SUPPORT_QQ=
# Telegram 用户名，不带 @
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=
# 例：每天 9:00 - 23:00
SUPPORT_HOURS=
# 客服二维码图片：把图片放到 public/ 下，这里填站内路径，例：/kefu.png
SUPPORT_QR=
# 小窗底部的补充说明，例：充值失败请提供卡密，我们会尽快处理
SUPPORT_NOTE=

# 上游（aiaiyg.com）。本站只做中转，不保存任何数据；留空即用 https://aiaiyg.com
UPSTREAM_BASE_URL=
# 查询类接口的超时（毫秒）；提交充值固定 90 秒（上游建单较慢）
UPSTREAM_TIMEOUT_MS=15000
